# Copy this file to .env and fill values only on your own computer.
# Never commit .env to Git or GitHub.

QUANT_ENVIRONMENT=development
QUANT_DATA_API_BASE_URL=
QUANT_DATA_API_KEY=
QUANT_HTTP_TIMEOUT_SECONDS=20

# Optional local QuantDinger signal-only integration.
# Create an Agent Token in QuantDinger with R and W scopes. Do not grant T/live scope.
QUANTDINGER_BASE_URL=http://127.0.0.1:8888
QUANTDINGER_AGENT_TOKEN=

